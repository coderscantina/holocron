  {
   "id": "AX-S017",
   "title": "2FA required and enrolled: login needs a challenge",
   "rule": "R-2FA",
   "status": "proposed (milestone 01)",
   "steps": [
    {
     "actor": "p_signed_out",
     "op": "auth.login",
     "args": {
      "user": "u_2fa",
      "password": "correct"
     },
     "expect": {
      "result": "allow",
      "response": {
       "status": "second_factor_required",
       "session": null,
       "partial_token": "present"
      }
     },
     "note": "no session cookie and no full token"
    },
    {
     "actor": "partial_token",
     "op": "analytics.explore",
     "args": {
      "site": "site_a1"
     },
     "expect": {
      "result": "deny",
      "status": 401,
      "code": "unauthenticated"
     },
     "note": "a partial token is never a session; upstream src/lib/auth.ts:81-86"
    },
    {
     "actor": "partial_token",
     "op": "auth.verifySecondFactor",
     "args": {
      "code": "wrong"
     },
     "expect": {
      "result": "deny",
      "status": 401,
      "code": "second_factor_invalid"
     }
    },
    {
     "actor": "partial_token",
     "op": "auth.verifySecondFactor",
     "args": {
      "code": "valid"
     },
     "expect": {
      "result": "allow",
      "response": {
       "session": "present"
      }
     }
    },
    {
     "actor": "p_2fa_enrolled",
     "op": "analytics.explore",
     "args": {
      "site": "site_a1"
     },
     "expect": {
      "result": "allow"
     }
    }
   ]
  },
  {
