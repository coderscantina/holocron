  {
   "id": "AX-S023",
   "title": "Bootstrap leaves no known default credentials",
   "rule": "R-BOOT",
   "status": "briefing (Maintenance and security): \"Generate or require bootstrap credentials; do not ship a known default password.\"",
   "steps": [
    {
     "surface": "cli",
     "actor": "operator",
     "op": "holocron init",
     "expect": {
      "result": "allow",
      "note": "either prints a generated one-time password once or requires one on stdin or a file"
     }
    },
    {
     "actor": "p_signed_out",
     "op": "auth.login",
     "args": {
      "user": "admin",
      "password": "umami"
     },
     "expect": {
      "result": "deny",
      "status": 401,
      "code": "invalid_credentials"
     },
     "note": "upstream seeds an admin user in prisma/migrations/01_init/migration.sql:199; Holocron must not ship it"
    },
    {
     "surface": "cli",
     "assert": "no secret appears in data-directory files in clear text, in logs, or in the diagnostics bundle"
    }
   ]
  },
  {
   "id": "AX-S024",
   "title": "Failed command stores nothing under its key",
   "rule": "R-IDEM-FAIL",
   "status": "adopted (decisions/0002-sessions-and-events.md, Request idempotency and batch IDs)",
   "steps": [
    {
     "actor": "p_member",
     "op": "boards.update",
     "idempotency_key": "K7",
     "args": {
      "board": "board_a1",
      "expected_revision": 5,
      "layout": "L4"
     },
     "expect": {
      "result": "deny",
      "status": 409,
      "code": "stale_revision"
     }
    },
    {
     "actor": "p_member",
     "op": "boards.update",
     "idempotency_key": "K7",
     "args": {
      "board": "board_a1",
      "expected_revision": 7,
      "layout": "L4"
     },
     "expect": {
      "result": "allow",
      "revision": 8,
      "replayed": false
     },
     "note": "same key, different arguments: no conflict, because the failure was not stored"
    },
    {
     "actor": "p_member",
     "op": "boards.update",
     "idempotency_key": "K7",
     "args": {
      "board": "board_a1",
      "expected_revision": 5,
      "layout": "L4"
     },
     "expect": {
      "result": "deny",
      "status": 409,
      "code": "idempotency_conflict"
     },
     "note": "after a stored success, different arguments conflict"
    }
   ]
  },
