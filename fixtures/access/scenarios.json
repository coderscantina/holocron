  {
   "id": "AX-S026",
   "title": "users.delete effects",
   "rule": "R-ERASE",
   "status": "adopted (decisions/0007-access-and-account-security.md, User erasure scope)",
   "steps": [
    {
     "actor": "p_key_site",
     "op": "analytics.explore",
     "args": {
      "site": "site_a1"
     },
     "expect": {
      "result": "allow"
     }
    },
    {
     "actor": "p_member",
     "op": "subscribe realtime.site",
     "args": {
      "site": "site_a1"
     },
     "expect": {
      "result": "allow"
     }
    },
    {
     "actor": "p_install_admin",
     "op": "users.delete",
     "args": {
      "user": "u_member"
     },
     "session": "reauthenticated 1 minute ago",
     "expect": {
      "result": "allow",
      "note": "returns a job id"
     }
    },
    {
     "expect_stream": "p_member subscription ends with access_revoked at once"
    },
    {
     "actor": "p_member",
     "op": "account.get",
     "expect": {
      "result": "deny",
      "status": 401,
      "code": "unauthenticated"
     },
     "note": "login sessions ended"
    },
    {
     "actor": "p_key_site",
     "op": "analytics.explore",
     "args": {
      "site": "site_a1"
     },
     "expect": {
      "result": "deny",
      "status": 401,
      "code": "unauthenticated"
     },
     "note": "the user's keys are revoked then deleted"
    },
    {
     "actor": "p_admin",
     "op": "boards.get",
     "args": {
      "board": "board_a1"
     },
     "expect": {
      "result": "allow",
      "response": "board kept; author shown as Deleted user"
     }
    },
    {
     "actor": "p_admin",
     "op": "explorations.get",
     "args": {
      "exploration": "exp_a1"
     },
     "expect": {
      "result": "deny",
      "status": 404,
      "code": "not_found"
     },
     "note": "own explorations of the deleted user are deleted"
    },
    {
     "actor": "p_admin",
     "op": "sharing.revoke",
     "args": {
      "share": "share_a1"
     },
     "expect": {
      "result": "allow"
     },
     "note": "shares the user created are kept and still manageable"
    },
    {
     "actor": "p_install_admin",
     "op": "jobs.status",
     "args": {
      "job": "users.delete"
     },
     "expect": {
      "result": "allow",
      "response": "complete; tombstone keeps user id and deletion time only"
     }
    }
   ]
  },
