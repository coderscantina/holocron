  {
   "id": "AX-S013",
   "title": "Subscription closes when membership is removed",
   "rule": "R-SUB",
   "status": "briefing (Control transactions and subscriptions): \"Reauthorize delivery when permissions or sessions change.\"",
   "steps": [
    {
     "actor": "p_removed",
     "state": "before_removal",
     "op": "subscribe realtime.site",
     "args": {
      "site": "site_a1"
     },
     "expect": {
      "result": "allow",
      "delivers": "snapshot, then events"
     }
    },
    {
     "event": "remove u_removed from ws_a"
    },
    {
     "expect_stream": "terminal event access_revoked, then close; no topic event with a log position after the revocation is delivered"
    },
    {
     "actor": "p_removed",
     "state": "after_removal",
     "op": "subscribe realtime.site",
     "args": {
      "site": "site_a1",
      "resume_cursor": "last seen"
     },
     "expect": {
      "result": "deny",
      "status": 404,
      "code": "not_found"
     },
     "note": "reconnect with a valid cursor still gets the not_found response, not a resync hint"
    }
   ]
  },
  {
