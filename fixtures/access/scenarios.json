  {
   "id": "AX-S016",
   "title": "Permission downgrade changes the topic set, not the whole subscription",
   "rule": "R-SUB",
   "status": "briefing (Control transactions and subscriptions): \"Reauthorize delivery when permissions or sessions change.\"",
   "steps": [
    {
     "actor": "p_member",
     "op": "subscribe realtime.site",
