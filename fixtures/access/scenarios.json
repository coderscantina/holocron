{
 "status": "proposed (milestone 01)",
 "note": "Steps run in order against one fresh seed of resources.json. 'event' steps change state through an operator or admin path outside the case. Each expect compares status, code and the named fields. 'expect_stream' asserts what the subscription socket sees. Session state `reauthenticated N minutes ago` uses the test clock (decision 0006).",
 "scenarios": [
  {
   "id": "AX-S001",
   "title": "Same key, same arguments returns the stored result",
   "rule": "R-IDEM",
   "status": "briefing (Control transactions): \"Bind each idempotency key to the principal, operation, and normalized argument fingerprint.\"",
   "steps": [
    {
     "actor": "p_member",
     "op": "boards.update",
     "idempotency_key": "K1",
     "args": {
      "board": "board_a1",
      "expected_revision": 7,
      "layout": "L1"
     },
     "expect": {
      "result": "allow",
      "revision": 8,
      "replayed": false
     }
    },
    {
     "actor": "p_member",
     "op": "boards.update",
     "idempotency_key": "K1",
     "args": {
      "board": "board_a1",
      "expected_revision": 7,
      "layout": "L1"
     },
     "expect": {
      "result": "allow",
      "revision": 8,
      "replayed": true,
      "note": "same body; no second revision; no second topic event"
     }
    }
   ]
  },
  {
   "id": "AX-S002",
   "title": "Same key, different arguments is a conflict",
   "rule": "R-IDEM",
   "status": "briefing (Control transactions): \"Bind each idempotency key to the principal, operation, and normalized argument fingerprint.\"",
   "steps": [
    {
     "actor": "p_member",
     "op": "boards.update",
     "idempotency_key": "K2",
     "args": {
      "board": "board_a1",
      "expected_revision": 7,
      "layout": "L1"
     },
     "expect": {
      "result": "allow",
      "revision": 8
     }
    },
    {
     "actor": "p_member",
     "op": "boards.update",
     "idempotency_key": "K2",
     "args": {
      "board": "board_a1",
      "expected_revision": 7,
      "layout": "L2"
     },
     "expect": {
      "result": "deny",
      "status": 409,
      "code": "idempotency_conflict"
     }
    }
   ]
  },
  {
   "id": "AX-S003",
   "title": "A key is bound to its principal",
   "rule": "R-IDEM",
   "status": "briefing (Control transactions): \"Bind each idempotency key to the principal, operation, and normalized argument fingerprint.\"",
   "steps": [
    {
     "actor": "p_member",
     "op": "boards.update",
     "idempotency_key": "K3",
     "args": {
      "board": "board_a1",
      "expected_revision": 7,
      "layout": "L1"
     },
     "expect": {
      "result": "allow",
      "revision": 8
     }
    },
    {
     "actor": "p_admin",
     "op": "boards.update",
     "idempotency_key": "K3",
     "args": {
      "board": "board_a1",
      "expected_revision": 7,
      "layout": "L1"
     },
     "expect": {
      "result": "deny",
      "status": 409,
      "code": "stale_revision"
     },
     "note": "p_admin's K3 is a new key: the command runs and meets the stale revision 7 against current 8. It never sees p_member's stored result and learns nothing about K3."
    }
   ]
  },
  {
   "id": "AX-S004",
   "title": "Replay after membership revoked is reauthorized and denied",
   "rule": "R-IDEM-REAUTH",
   "status": "briefing (Control transactions): \"Reauthorize access before returning a stored result after membership changes.\"",
   "steps": [
    {
     "actor": "p_removed",
     "state": "before_removal",
     "op": "boards.update",
     "idempotency_key": "K4",
     "args": {
      "board": "board_a1",
      "expected_revision": 7,
      "layout": "L1"
     },
     "expect": {
      "result": "allow",
      "revision": 8
     }
    },
    {
     "event": "remove u_removed from ws_a"
    },
    {
     "actor": "p_removed",
     "state": "after_removal",
     "op": "boards.update",
     "idempotency_key": "K4",
     "args": {
      "board": "board_a1",
      "expected_revision": 7,
      "layout": "L1"
     },
     "expect": {
      "result": "deny",
      "status": 404,
      "code": "not_found"
     },
     "note": "stored result must not be returned; response identical to a missing board"
    }
   ]
  },
  {
   "id": "AX-S005",
   "title": "Replay after the capability was downgraded is reauthorized",
   "rule": "R-IDEM-REAUTH",
   "status": "briefing (Control transactions): \"Reauthorize access before returning a stored result after membership changes.\"",
   "steps": [
    {
     "actor": "p_member",
     "op": "boards.update",
     "idempotency_key": "K5",
     "args": {
      "board": "board_a1",
      "expected_revision": 7,
      "layout": "L1"
     },
     "expect": {
      "result": "allow",
      "revision": 8
     }
    },
    {
     "event": "change u_member in ws_a from member to viewer"
    },
    {
     "actor": "p_member",
     "op": "boards.update",
     "idempotency_key": "K5",
     "args": {
      "board": "board_a1",
      "expected_revision": 7,
      "layout": "L1"
     },
     "expect": {
      "result": "deny",
      "status": 403,
      "code": "forbidden"
     }
    }
   ]
  },
  {
   "id": "AX-S006",
   "title": "One-time key secret is withheld on replay",
   "rule": "R-IDEM-SECRET",
   "status": "briefing (Control transactions): \"One-time credentials and keys need a withholding policy rather than durable replay of the original secret.\" Response shape is proposed.",
   "steps": [
    {
     "actor": "p_member",
     "op": "apiKeys.create",
     "idempotency_key": "K6",
     "args": {
      "operations": [
       "analytics.explore"
      ],
      "sites": [
       "site_a1"
      ],
      "name": "ci"
     },
     "expect": {
      "result": "allow",
      "response": {
       "key_id": "present",
       "secret": "present, disclosed once"
      }
     },
     "session": "reauthenticated 1 minute ago"
    },
    {
     "actor": "p_member",
     "op": "apiKeys.create",
     "idempotency_key": "K6",
     "args": {
      "operations": [
       "analytics.explore"
      ],
      "sites": [
       "site_a1"
      ],
      "name": "ci"
     },
     "expect": {
      "result": "allow",
      "replayed": true,
      "response": {
       "key_id": "same",
       "secret": null,
       "secret_withheld": true
      },
      "note": "no second key is created and the secret never appears in stored responses"
     },
     "session": "reauthenticated 1 minute ago"
    }
   ]
  },
  {
   "id": "AX-S007",
   "title": "Stale expected revision on an accessible resource",
   "rule": "R-REV",
   "status": "briefing (Control transactions): \"reject stale expected revisions without disclosing inaccessible resources.\"",
   "steps": [
    {
     "actor": "p_member",
     "op": "boards.update",
     "args": {
      "board": "board_a1",
      "expected_revision": 5,
      "layout": "L3"
     },
     "expect": {
      "result": "deny",
      "status": 409,
      "code": "stale_revision",
      "body_includes": "current_revision 7"
     }
    }
   ]
  },
  {
   "id": "AX-S008",
   "title": "Stale expected revision on an inaccessible or missing resource",
   "rule": "R-REV",
   "status": "briefing (Control transactions): \"reject stale expected revisions without disclosing inaccessible resources.\"",
   "steps": [
    {
     "actor": "p_member",
     "op": "boards.update",
     "args": {
      "board": "board_b1",
      "expected_revision": 5,
      "layout": "L3"
     },
     "expect": {
      "result": "deny",
      "status": 404,
      "code": "not_found"
     },
     "same_response_group": "stale-hidden"
    },
    {
     "actor": "p_member",
     "op": "boards.update",
     "args": {
      "board": "board_missing",
      "expected_revision": 5,
      "layout": "L3"
     },
     "expect": {
      "result": "deny",
      "status": 404,
      "code": "not_found"
     },
     "same_response_group": "stale-hidden",
     "note": "access and existence are checked before the revision; no current_revision in the body"
    },
    {
     "actor": "p_viewer",
     "op": "boards.update",
     "args": {
      "board": "board_a1",
      "expected_revision": 5,
      "layout": "L3"
     },
     "expect": {
      "result": "deny",
      "status": 403,
      "code": "forbidden"
     },
     "note": "capability is checked before the revision too; a viewer learns no revision number"
    }
   ]
  },
  {
   "id": "AX-S009",
