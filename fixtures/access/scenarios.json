  {
   "id": "AX-S021",
   "title": "Password change invalidates older sessions",
   "rule": "R-AUTH",
   "status": "proposed (milestone 01)",
   "steps": [
    {
     "actor": "p_member",
     "session": "S1",
     "op": "account.get",
     "expect": {
      "result": "allow"
     }
    },
    {
     "actor": "p_member",
     "session": "S2",
     "op": "account.changePassword",
     "args": {
      "new": "n"
     },
     "expect": {
      "result": "deny",
      "status": 403,
      "code": "reauthentication_required"
     },
     "note": "changePassword needs reauthentication"
    },
    {
     "actor": "p_member",
     "session": "S2",
     "op": "auth.reauthenticate",
     "args": {
      "password": "correct"
     },
     "expect": {
      "result": "allow"
     }
    },
    {
     "actor": "p_member",
     "session": "S2",
     "op": "account.changePassword",
     "args": {
      "new": "n"
     },
     "expect": {
      "result": "allow"
     }
    },
    {
     "actor": "p_member",
     "session": "S1",
     "op": "account.get",
     "expect": {
      "result": "deny",
      "status": 401,
      "code": "unauthenticated"
     },
     "note": "upstream src/lib/auth.ts:98-103 compares a password fingerprint"
    },
    {
     "actor": "p_member",
     "session": "S2",
     "op": "account.get",
     "expect": {
      "result": "allow"
     },
     "note": "proposed: the session that changed the password stays valid"
    }
   ]
